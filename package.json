{
  "name": "image-scout",
  "productName": "ImageScout",
  "version": "0.1.0",
  "description": "A fast desktop image search launcher",
  "author": "Image Scout",
  "license": "AGPL-3.0-only",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/third-party-notices.cjs && vite build",
    "icons": "node scripts/make-icon.cjs",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "playwright test",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@imgly/background-removal": "1.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.577.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "vite": "8.3.0"
  },
  "build": {
    "appId": "com.imagescout.desktop",
    "productName": "ImageScout",
    "directories": {"output": "release"},
    "files": ["dist/**/*", "electron/**/*", "resources/**/*", "package.json", "LICENSE", "!node_modules/**/*"],
    "electronLanguages": ["en-US"],
    "asar": true,
    "win": {"target": "portable", "icon": "resources/icon.ico", "signAndEditExecutable": true, "signExecutable": false},
    "portable": {"artifactName": "ImageScout-${version}.exe"}
  }
}
